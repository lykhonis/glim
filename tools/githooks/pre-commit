#!/usr/bin/env node
// Pre-commit: reject staged C++ that clang-format would reword.
const { execFileSync, spawnSync } = require("child_process");
const fs = require("fs");
const root = execFileSync("git", ["rev-parse", "--show-toplevel"], { encoding: "utf8" }).trim();
const staged = execFileSync("git", ["diff", "--cached", "--name-only", "--diff-filter=ACM"], {
  cwd: root,
  encoding: "utf8",
})
  .split("\n")
  .filter((f) => /\.(cpp|h)$/.test(f) && !f.startsWith("vendor/"));
if (!staged.length) process.exit(0);
if (!fs.existsSync(`${root}/node_modules/@wasm-fmt/clang-format`)) {
  console.error("pre-commit: run pnpm install for the formatter, skipping format check");
  process.exit(0);
}
const r = spawnSync("node", ["tools/format.mjs", "--check", ...staged], { cwd: root, stdio: "inherit" });
process.exit(r.status ?? 1);
