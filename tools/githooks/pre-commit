#!/bin/sh
# Pre-commit: reject C++ that clang-format would reword. Warn-and-pass until
# `pnpm install` has fetched the pinned formatter.
cd "$(git rev-parse --show-toplevel)" || exit 1
staged=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|h)$' | grep -v '^vendor/' || true)
if [ -z "$staged" ]; then
  exit 0
fi
if [ ! -d node_modules/@wasm-fmt/clang-format ]; then
  echo "pre-commit: run pnpm install for the formatter, skipping format check" >&2
  exit 0
fi
# shellcheck disable=SC2086
exec node tools/format.mjs --check $staged
