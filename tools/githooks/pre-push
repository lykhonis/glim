#!/bin/sh
# Pre-push: backstop for formatting (catches --no-verify commits or clones
# without the hook configured).
cd "$(git rev-parse --show-toplevel)" || exit 1
if [ ! -d node_modules/@wasm-fmt/clang-format ]; then
  echo "pre-push: run pnpm install for the formatter, skipping format check" >&2
  exit 0
fi
exec node tools/format.mjs --check
