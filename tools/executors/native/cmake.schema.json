{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "properties": {
    "preset": { "type": "string", "description": "CMake configure/build preset name" },
    "target": { "type": "string", "description": "CMake target to build" },
    "buildDir": { "type": "string", "description": "Fallback -B directory when preset is omitted" }
  },
  "required": ["target"]
}
