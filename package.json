{
  "name": "glim",
  "private": true,
  "author": {
    "name": "Volodymyr Lykhonis",
    "url": "https://lykhonis.com"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "nx run examples:build",
    "test": "nx run-many -t test",
    "format": "node tools/format.mjs",
    "format:check": "node tools/format.mjs --check",
    "lint": "node -e \"require('./tools/githooks/checks').lint()\"",
    "shaders": "node tools/shaders.mjs",
    "doc-links": "node tools/doc-links.mjs",
    "typecheck": "tsc -p tools/tsconfig.json",
    "test:host": "node -e \"require('./tools/githooks/checks').hostTests()\"",
    "postinstall": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config core.hooksPath tools/githooks || true",
    "hello": "nx run hello:run",
    "regen-goldens": "nx run examples:regen-goldens --output-style=stream",
    "web-goldens": "cmake -S tools/glim-golden -B build/glim-golden -DCMAKE_BUILD_TYPE=Release && cmake --build build/glim-golden && node tools/web-goldens.mjs"
  },
  "devDependencies": {
    "@glim/native": "workspace:*",
    "@types/node": "24",
    "@wasm-fmt/clang-format": "18.1.8",
    "nx": "^20.3.0",
    "typescript": "5"
  }
}
