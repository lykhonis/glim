{
  "name": "hello",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "examples/hello",
  "projectType": "application",
  "tags": ["example"],
  "implicitDependencies": ["core"],
  "targets": {
    "build": {
      "executor": "@glim/native:cmake",
      "options": {
        "preset": "macos-metal-debug",
        "target": "glim-hello",
        "install": true
      }
    },
    "run": {
      "executor": "@glim/native:run",
      "dependsOn": ["build"],
      "cache": false,
      "options": {
        "preset": "macos-metal-debug",
        "binary": "examples/hello/glim-hello"
      }
    },
    "build-software": {
      "executor": "@glim/native:cmake",
      "options": {
        "preset": "macos-metal-debug",
        "target": "glim-hello-software"
      }
    },
    "run-software": {
      "executor": "@glim/native:run",
      "dependsOn": ["build-software"],
      "cache": false,
      "options": {
        "preset": "macos-metal-debug",
        "binary": "examples/hello/glim-hello-software"
      }
    },
    "test": {
      "executor": "@glim/native:cmake",
      "options": {
        "preset": "macos-metal-debug",
        "target": "glim-hello-golden",
        "ctestRegex": "glim-hello-golden"
      }
    },
    "build-ios-sim": {
      "executor": "@glim/native:cmake",
      "options": {
        "preset": "ios-sim-metal-debug",
        "target": "glim-hello"
      }
    },
    "run-ios": {
      "executor": "@glim/native:run",
      "dependsOn": ["build-ios-sim"],
      "cache": false,
      "options": {
        "preset": "ios-sim-metal-debug",
        "binary": "examples/hello/glim-hello.app",
        "simulator": "ios",
        "bundleId": "com.lykhonis.glim.hello"
      }
    },
    "build-tvos-sim": {
      "executor": "@glim/native:cmake",
      "options": {
        "preset": "tvos-sim-metal-debug",
        "target": "glim-hello"
      }
    },
    "run-tvos": {
      "executor": "@glim/native:run",
      "dependsOn": ["build-tvos-sim"],
      "cache": false,
      "options": {
        "preset": "tvos-sim-metal-debug",
        "binary": "examples/hello/glim-hello.app",
        "simulator": "tvos",
        "bundleId": "com.lykhonis.glim.hello"
      }
    }
  }
}
