{
  "name": "showcase",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "examples/showcase",
  "projectType": "application",
  "tags": ["example"],
  "implicitDependencies": ["toolkit"],
  "targets": {
    "build": {
      "executor": "@glim/native:cmake",
      "options": {
        "preset": "macos-metal-debug",
        "target": "glim-showcase"
      },
      "configurations": {
        "release": {
          "preset": "macos-metal-release"
        }
      }
    },
    "run": {
      "executor": "@glim/native:run",
      "dependsOn": ["build"],
      "cache": false,
      "options": {
        "preset": "macos-metal-debug",
        "binary": "examples/showcase/glim-showcase"
      },
      "configurations": {
        "release": {
          "preset": "macos-metal-release"
        }
      }
    },
    "test": {
      "executor": "@glim/native:cmake",
      "options": {
        "preset": "macos-metal-debug",
        "target": "glim-showcase-golden",
        "ctestRegex": "glim-showcase-golden"
      }
    },
    "build-ios-sim": {
      "executor": "@glim/native:cmake",
      "options": {
        "preset": "ios-sim-metal-debug",
        "target": "glim-showcase"
      }
    },
    "run-ios": {
      "executor": "@glim/native:run",
      "dependsOn": ["build-ios-sim"],
      "cache": false,
      "options": {
        "preset": "ios-sim-metal-debug",
        "binary": "examples/showcase/glim-showcase.app",
        "simulator": "ios",
        "bundleId": "com.glim.showcase"
      }
    },
    "build-android": {
      "executor": "@glim/native:cmake",
      "options": {
        "preset": "android-arm64-vulkan-debug",
        "target": "glim-showcase"
      }
    },
    "run-android": {
      "executor": "@glim/native:run",
      "dependsOn": ["build-android"],
      "cache": false,
      "options": {
        "preset": "android-arm64-vulkan-debug",
        "binary": "examples/showcase/glim-showcase.apk",
        "android": true,
        "packageName": "com.glim.showcase"
      }
    }
  }
}
