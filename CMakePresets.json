{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "macos-metal-debug",
      "displayName": "macOS Metal Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-metal-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "GLIM_GPU": "metal",
        "GLIM_SHELL": "macos"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "macos-metal-release",
      "displayName": "macOS Metal Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-metal-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.0",
        "GLIM_GPU": "metal",
        "GLIM_SHELL": "macos"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "ios-sim-metal-debug",
      "displayName": "iOS Simulator Metal Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ios-sim-metal-debug",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphonesimulator",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "16.0",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
        "CMAKE_BUILD_TYPE": "Debug",
        "GLIM_GPU": "metal",
        "GLIM_SHELL": "ios"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "ios-metal-debug",
      "displayName": "iOS Device Metal Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ios-metal-debug",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_SYSROOT": "iphoneos",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "16.0",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
        "CMAKE_BUILD_TYPE": "Debug",
        "GLIM_GPU": "metal",
        "GLIM_SHELL": "ios"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "tvos-sim-metal-debug",
      "displayName": "tvOS Simulator Metal Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/tvos-sim-metal-debug",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "tvOS",
        "CMAKE_OSX_SYSROOT": "appletvsimulator",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "16.0",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
        "CMAKE_BUILD_TYPE": "Debug",
        "GLIM_GPU": "metal",
        "GLIM_SHELL": "tvos"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    },
    {
      "name": "tvos-metal-debug",
      "displayName": "tvOS Device Metal Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/tvos-metal-debug",
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "tvOS",
        "CMAKE_OSX_SYSROOT": "appletvos",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "16.0",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_TRY_COMPILE_TARGET_TYPE": "STATIC_LIBRARY",
        "CMAKE_BUILD_TYPE": "Debug",
        "GLIM_GPU": "metal",
        "GLIM_SHELL": "tvos"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    }
  ],
  "buildPresets": [
    { "name": "macos-metal-debug", "configurePreset": "macos-metal-debug" },
    { "name": "macos-metal-release", "configurePreset": "macos-metal-release" },
    { "name": "ios-sim-metal-debug", "configurePreset": "ios-sim-metal-debug" },
    { "name": "ios-metal-debug", "configurePreset": "ios-metal-debug" },
    { "name": "tvos-sim-metal-debug", "configurePreset": "tvos-sim-metal-debug" },
    { "name": "tvos-metal-debug", "configurePreset": "tvos-metal-debug" }
  ],
  "testPresets": [
    {
      "name": "macos-metal-debug",
      "configurePreset": "macos-metal-debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
