{
  "name": "paint",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/glim-paint",
  "implicitDependencies": ["core"],
  "targets": {
    "build": {
      "executor": "@glim/native:cmake",
      "options": {
        "preset": "macos-metal-debug",
        "target": "glim-paint"
      }
    },
    "test": {
      "executor": "@glim/native:cmake",
      "options": {
        "preset": "macos-metal-debug",
        "target": "glim-merge-test",
        "ctestRegex": "glim-merge-test"
      }
    }
  }
}
